@page
@model ROTGBot.Pages.News.IndexModel
@{
    ViewData["Title"] = "Список обращений";
}

<h1>Продукты</h1>

<p>
    <a class="btn btn-primary" id="addProduct" asp-page="Create">Новый</a>
</p>
<table class="table" id="productTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.News[0].Number)
            </th>
            <td>
                @Html.DisplayNameFor(model => model.News[0].Title)
            </td>
            <th>
                @Html.DisplayNameFor(model => model.News[0].Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.News[0].Messages)
            </th>           
            <th>
                @Html.DisplayNameFor(model => model.News[0].CreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.News[0].State)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.News)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Number)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Messages)
                </td>               
                <td>
                    @Html.DisplayFor(modelItem => item.CreatedDate)
                </td>
                 <td>
                    @Html.DisplayFor(modelItem => item.State)
                </td>   
                <td>                    
                    <a class="btn btn-info" asp-page="./Details" asp-route-id="@item.Id">Подробно</a>
                    <a class="btn btn-warning" asp-page="./AnswerNews" asp-route-id="@item.Id">Ответить</a>
                    <a class="btn btn-primary" asp-page="./ChangeStatus" asp-route-id="@item.Id">Редактировать</a>
                    <a class="btn btn-primary" asp-page="./ResendNews" asp-route-id="@item.Id">Отправить повторно</a>
                </td>
            </tr>
        }
    </tbody>
</table>

