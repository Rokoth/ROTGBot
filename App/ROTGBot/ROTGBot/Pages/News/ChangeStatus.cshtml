@page
@{
    ViewData["Title"] = "Изменение статуса обращения";
}

<h1>Редактировать продукт</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="News.Id" class="form-control" />
            <div class="form-group p-3 border bg-light">
                <label asp-for="News.Name" class="control-label"></label>
                <input id="nameField" asp-for="News.Name" class="form-control" />
                <span asp-validation-for="News.Name" class="text-danger"></span>
            </div>
            <div class="form-group p-3 border bg-light">
                <label asp-for="News.Description" class="control-label"></label>
                <input id="descriptionField" asp-for="News.Description" class="form-control" />
                <span asp-validation-for="News.Description" class="text-danger"></span>
            </div>
            <div class="form-group p-3 border bg-light">
                <label asp-for="Product.Price" class="control-label"></label>
                <input id="priceField" type="number" asp-for="Product.Price" class="form-control" />
                <span asp-validation-for="Product.Price" class="text-danger"></span>
            </div>
            <div class="form-group p-3 border bg-light row g-0">
                <div class="col-6 d-flex justify-content-center">
                    <input type="submit" id="editButton" value="Сохранить" class="btn btn-primary" />
                </div>
                <div class="col-6 d-flex justify-content-center">
                    <a class="btn btn-warning" asp-page="Index">Вернуться</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
