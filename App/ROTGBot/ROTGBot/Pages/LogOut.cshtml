@page
@model ROTGBot.Pages.LogOutModel
@{
    ViewData["Title"] = "Выход";
}
<h1>Авторизация</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <input id="authButton" type="submit" value="Выйти" class="btn btn-primary" />
                <a asp-page="Index">Вернуться</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}