@page
@model ROTGBot.Pages.User.BlockUserModel
@{
    ViewData["Title"] = "Блокировка пользователя";
}

<h2>Вы действительно хотите заблокировать пользователя?</h2>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div class="form-group p-3 border bg-light">
                <b>@Html.DisplayNameFor(x => x.UserModel.Name)</b> :
                @Html.DisplayFor(x => x.UserModel.Name)
            </div>
            <div class="form-group p-3 border bg-light">
                <b>
                    @Html.DisplayNameFor(x => x.UserModel.Login)
                </b>:
                @Html.DisplayFor(x => x.UserModel.Login)
            </div>            
            <div class="form-group p-3 border bg-light">
                <input type="submit" value="Заблокировать" class="btn btn-primary" /> |
                <a class="btn btn-warning" asp-page="Index">Вернуться</a>
            </div>
        </form>
    </div>
</div>
