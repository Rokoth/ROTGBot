@page
@model ROTGBot.Pages.User.AddUserRoleModel
@{
    ViewData["Title"] = "Добавление роли";
}

<h1>Добавление роли</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UserRole.UserId" class="form-control" />            
            <div class="form-group p-3 border bg-light">
                <label asp-for="UserRole.UserName" class="control-label"></label>
                <input id="userNameField" readonly="true" asp-for="UserRole.UserName" class="form-control" />
                <span asp-validation-for="UserRole.UserName" class="text-danger"></span>
            </div>
            <div class="form-group p-3 border bg-light">
                @Html.LabelFor(model => model.UserRole.RoleId, htmlAttributes: new { @class = "control-label col-md-2" })
                <div class="col-md-10">
                    @Html.DropDownListFor(model => model.UserRole.RoleId, Model.Roles, new { @class = "form-control" })
                    @Html.ValidationMessageFor(model => model.UserRole.RoleId, "", new { @class = "text-danger" })
                </div>
            </div>
            <div class="form-group p-3 border bg-light row g-0">
                <div class="col-6 d-flex justify-content-center">
                    <input type="submit" value="Добавить" class="btn btn-primary" />
                </div>
                <div class="col-6 d-flex justify-content-center">
                    <a class="btn btn-warning" asp-page="Index">Вернуться</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
