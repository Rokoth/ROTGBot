@page
@model ROTGBot.Pages.User.UnblockUserModel
@{
    ViewData["Title"] = "Разблокировка пользователя";
}

<h1>Вы действительно хотите разблокировать пользователя?</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UserModel.Id" class="form-control" />            
            <div class="form-group p-3 border bg-light">
                <label asp-for="UserModel.Name" class="control-label"></label>
                <input id="userNameField" readonly asp-for="UserModel.Name" class="form-control" />
                <span asp-validation-for="UserModel.Name" class="text-danger"></span>
            </div>
            <div class="form-group p-3 border bg-light">
                <label asp-for="UserModel.TGLogin" class="control-label"></label>
                <input id="roleNameField" readonly asp-for="UserModel.TGLogin" class="form-control" />
                <span asp-validation-for="UserModel.TGLogin" class="text-danger"></span>
            </div>
            <div class="form-group p-3 border bg-light row g-0">
                <div class="col-6 d-flex justify-content-center">
                    <input type="submit" value="Разблокировать" class="btn btn-primary" />
                </div>
                <div class="col-6 d-flex justify-content-center">
                    <a class="btn btn-warning" asp-page="Index">Вернуться</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

