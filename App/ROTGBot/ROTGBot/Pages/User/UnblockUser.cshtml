@page
@model ROTGBot.Pages.User.UnblockUserModel
@{
    ViewData["Title"] = "Разблокировка пользователя";
}

<h2>Вы действительно хотите удалить продукт?</h2>
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div class="form-group p-3 border bg-light">
                <b>@Html.DisplayNameFor(x => x.Product.Name)</b> :
                @Html.DisplayFor(x => x.Product.Name)
            </div>
            <div class="form-group p-3 border bg-light">
                <b>
                    @Html.DisplayNameFor(x => x.Product.Description)
                </b>:
                @Html.DisplayFor(x => x.Product.Description)
            </div>
            <div class="form-group p-3 border bg-light">
                <b>
                    @Html.DisplayNameFor(x => x.Product.Price)
                </b>:
                @Html.DisplayFor(x => x.Product.Price)
            </div>
            <div class="form-group p-3 border bg-light">
                <input type="submit" value="Удалить" class="btn btn-primary" /> |
                <a class="btn btn-warning" asp-page="Index">Вернуться</a>
            </div>
        </form>
    </div>
</div>
