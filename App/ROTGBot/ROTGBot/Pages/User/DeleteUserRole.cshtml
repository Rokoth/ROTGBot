@page
@model ROTGBot.Pages.User.DeleteUserRoleModel
@{
    ViewData["Title"] = "Удаление роли";
}

<h1>Вы действительно хотите удалить роль пользователя?</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="UserRole.UserId" class="form-control" />
            <input type="hidden" asp-for="UserRole.RoleId" class="form-control" />
            <div class="form-group p-3 border bg-light">
                <label asp-for="UserRole.UserName" class="control-label"></label>
                <input id="userNameField" readonly="true" asp-for="UserRole.UserName" class="form-control" />
                <span asp-validation-for="UserRole.UserName" class="text-danger"></span>
            </div>
            <div class="form-group p-3 border bg-light">
                <label asp-for="UserRole.RoleName" class="control-label"></label>
                <input id="roleNameField" readonly="true" asp-for="UserRole.RoleName" class="form-control" />
                <span asp-validation-for="UserRole.RoleName" class="text-danger"></span>
            </div>           
            <div class="form-group p-3 border bg-light row g-0">
                <div class="col-6 d-flex justify-content-center">
                    <input type="submit" value="Удалить" class="btn btn-primary" />
                </div>
                <div class="col-6 d-flex justify-content-center">
                    <a class="btn btn-warning" asp-page="Index">Вернуться</a>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
