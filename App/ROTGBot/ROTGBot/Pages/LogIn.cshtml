@page
@model ROTGBot.Pages.LogInModel
@{
    ViewData["Title"] = "Авторизация";
    bool LoginSended = Model.LoginSended;
}
<h1>Авторизация</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <div class="text-danger">
            @Html.DisplayFor(modelItem => modelItem.Error)
        </div>
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if(!LoginSended)
            {
                <div class="form-group">
                    <label asp-for="Login" class="control-label"></label>
                    <input id="loginField" asp-for="Login" class="form-control" />
                    <span asp-validation-for="Login" class="text-danger"></span>
                </div>
            }
            @if (LoginSended)
            {
                <div class="form-group">
                    <label asp-for="Password" class="control-label"></label>
                    <input id="passwordField" asp-for="Password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
            }
            <div class="form-group">
                @if (!LoginSended)
                {
                    <input id="passButton" type="submit" value="Отправить пароль" class="btn btn-primary" />
                }
                @if (LoginSended)
                {
                    <input id="authButton" type="submit" value="Подтвердить" class="btn btn-primary" />
                }
                <a asp-page="Index">Вернуться</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
