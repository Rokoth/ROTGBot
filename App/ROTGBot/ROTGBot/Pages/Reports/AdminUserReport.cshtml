@page
@model ROTGBot.Pages.Reports.AdminUserReportModel
@{
    ViewData["Title"] = "Отчёт по пользователям по отправленным сообщениям";
}

<h1>Отчет</h1>

<p>
    <!--Фильтры-->
</p>
<table class="table" id="reportTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Report.Items[0].Year)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Report.Items[0].Month)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Report.Items[0].Count)
            </th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Report.Items)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Year)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Month)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Count)
                </td>
            </tr>
        }
    </tbody>
</table>
