@page
@model ROTGBot.Pages.Reports.UserReportModel
@{
    ViewData["Title"] = "Отчёт по отправленным сообщениям";
}

<h1>Отчет</h1>

<p>
    <h2>Фильтры</h2>
    <div class="row">
        <div class="col-md-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group p-3 border bg-light">
                    @Html.LabelFor(model => model.Filter.From, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DisplayFor(model => model.Filter.From, new { @class = "form-control" });
                        @Html.ValidationMessageFor(model => model.Filter.From, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group p-3 border bg-light">
                    @Html.LabelFor(model => model.Filter.To, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DisplayFor(model => model.Filter.To, new { @class = "form-control" });
                        @Html.ValidationMessageFor(model => model.Filter.To, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group p-3 border bg-light">
                    @Html.LabelFor(model => model.Filter.States, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="col-md-10">
                        @Html.DropDownListFor(model => model.Filter.States, Model.AllStates, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Filter.States, "", new { @class = "text-danger" })
                    </div>
                </div>
                <div class="form-group p-3 border bg-light row g-0">
                    <div class="col-6 d-flex justify-content-center">
                        <input type="submit" value="Применить" class="btn btn-primary" />
                    </div>
                </div>
            </form>
        </div>
    </div>

</p>

@foreach (var byYear in Model.Report.Items)
{
    <div>@Html.DisplayNameFor(modelItem => byYear.Year) : @Html.DisplayFor(modelItem => byYear.Year)</div>

    @foreach (var byMonth in byYear.ChildItems)
    {
        <div>@Html.DisplayNameFor(modelItem => byMonth.Month) : @Html.DisplayFor(modelItem => byMonth.Month)</div>

        <table class="table" id="reportTable">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => byMonth.ChildItems[0].Type)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => byMonth.ChildItems[0].Count)
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in byMonth.ChildItems)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.Type)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.Count)
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    }

    <div>@Html.DisplayNameFor(modelItem => byYear.Total) : @Html.DisplayFor(modelItem => byYear.Total)</div>
}


<div>@Html.DisplayNameFor(modelItem => Model.Report.Total) : @Html.DisplayFor(modelItem => Model.Report.Total)</div>

<div class="col-6 d-flex justify-content-center">
    <a class="btn btn-warning" asp-page="Index">Вернуться</a>
</div>
